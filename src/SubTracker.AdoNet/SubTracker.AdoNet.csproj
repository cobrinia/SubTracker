<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Шар прямого доступу до SQL Server через ADO.NET (Microsoft.Data.SqlClient):
    параметризовані SQL-команди, SqlDataReader, транзакції.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Пряма залежність перекриває вразливу транзитивну версію 9.0.x. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubTracker.Domain\SubTracker.Domain.csproj" />
  </ItemGroup>

</Project>
