<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Шар доступу до даних через Entity Framework Core:
    DbContext, Fluent API-конфігурації, міграції, початкові дані, EF-сервіси та LINQ-запити.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Пряма залежність перекриває вразливу транзитивну версію 9.0.x, яку тягне SqlClient. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubTracker.Domain\SubTracker.Domain.csproj" />
  </ItemGroup>

</Project>
