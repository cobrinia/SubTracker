<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Database First / Reverse Engineering (пункт 12 ходу роботи).
    Вміст (Entities/*.cs, ScaffoldedDbContext.cs) ГЕНЕРУЄТЬСЯ командою dotnet ef dbcontext scaffold
    з існуючої БД SubTrackerDb. Проєкт навмисно відокремлений: на нього ніхто не посилається,
    щоб згенерована модель не змішувалась з Code First моделлю в SubTracker.DB.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Потрібен dotnet ef, коли цей проєкт є startup-проєктом для scaffolding. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
