<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Точка входу: конфігурація (appsettings.json + user secrets), DI та демонстраційне меню.
    Також startup-проєкт для dotnet ef (міграції, scaffolding).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Простір імен ConsoleApp, а не Console: інакше SubTracker.Console «перекриє» System.Console. -->
    <RootNamespace>SubTracker.ConsoleApp</RootNamespace>
    <UserSecretsId>825e9d5f-16cf-49a3-9adf-9e2fead991c3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubTracker.AdoNet\SubTracker.AdoNet.csproj" />
    <ProjectReference Include="..\SubTracker.DB\SubTracker.DB.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
